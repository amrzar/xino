
/**
 * @file linker.ldspp
 * @brief Layout and symbol-visibility contract for the uKernel image.
 *
 * Motivation for the pervasive `HIDDEN(...)` assignments:
 *
 *  - Early boot (start.S, reloc.c, percpu.cpp, boot allocator) runs with the
 *    MMU disabled; addresses must be materialized via PC-relative sequences.
 *  - Hidden symbols are non-preemptible, so the linker is forced to generate
 *    direct references instead of GOT/PLT indirections.
 *  - Only symbols consumed after paging is enabled (e.g., EH tables, fini
 *    arrays, GOT) remain visible to aid diagnostics and tooling.
 */

#include <config.h>

OUTPUT_ARCH(aarch64)
ENTRY(_start)

SECTIONS
{
  . = 0;

  HIDDEN(__image_start = .);

  .text : ALIGN(16) {
    HIDDEN(__text_start = .);
    KEEP(*(.text.start))
    *(.text .text.*)
    HIDDEN(__text_end = .);
  }

  . = ALIGN(UKERNEL_PAGE_SIZE);

  .rodata : ALIGN(16) {
    HIDDEN(__rodata_start = .);
    *(.rodata .rodata.*)
    HIDDEN(__rodata_end = .);
  }

  /* Exception handling and unwinding info. */
  .eh_frame_hdr : ALIGN(8) {
    __eh_frame_hdr_start = .;
    KEEP(*(.eh_frame_hdr))
    __eh_frame_hdr_end = .;
  }

  .eh_frame : ALIGN(8) {
    __eh_frame_start = .;
    KEEP(*(.eh_frame))
    KEEP(*(.eh_frame.*))
    __eh_frame_end = .;
  }

  .gcc_except_table : ALIGN(8) {
    *(.gcc_except_table .gcc_except_table.*)
  }

  /* START RELRO. */
  /* GNU_RELRO. */

  /* C++ static initialization arrays. */
  .init_array : ALIGN(8) {
    HIDDEN(__init_array_start = .);
    KEEP(*(.init_array .init_array.*))
    HIDDEN(__init_array_end = .);
  }

  .fini_array : ALIGN(8) {
    __fini_array_start = .;
    KEEP(*(.fini_array .fini_array.*))
    __fini_array_end = .;
  }

  .got : ALIGN(8) {
    __got_start = .;
    *(.got .got.*)
    __got_end = .;
  }

  HIDDEN(__relro_end = .);

  . = ALIGN(UKERNEL_PAGE_SIZE);

  /* END RELRO. */

  /* START DATA (RW). */

  .data : ALIGN(16) {
    HIDDEN(__data_start = .);
    *(.data .data.*)
    HIDDEN(__data_end = .);
  }

  .percpu : ALIGN(UKERNEL_CACHE_LINE) {
    HIDDEN(__percpu_aligned_start = .);
    KEEP(*(.percpu_aligned .percpu_aligned.*))
    HIDDEN(__percpu_start = .);
    KEEP(*(.percpu .percpu.*))
    . = ALIGN(UKERNEL_CACHE_LINE);
    HIDDEN(__percpu_end = .);
  }

  .bss (NOLOAD) : ALIGN(16) {
    HIDDEN(__bss_start = .);
    /* Keep initial stack in .bss. */
    HIDDEN(__stack_bottom = .);
    . += UKERNEL_STACK_SIZE;
    HIDDEN(__stack_top = .);
    *(.bss .bss.*)
    *(COMMON)
    HIDDEN(__bss_end = .);
  }

  .boot_heap (NOLOAD) : ALIGN(UKERNEL_PAGE_SIZE) {
    HIDDEN(__boot_heap_start = .);
    . += UKERNEL_BOOT_HEAP_SIZE;
    . = ALIGN(UKERNEL_PAGE_SIZE);
    HIDDEN(__boot_heap_end = .);
  }

  . = ALIGN(UKERNEL_PAGE_SIZE);

  /* END DATA. */

  .rela.dyn : ALIGN(8) {
    HIDDEN(__rela_dyn_start = .);
    *(.rela.dyn .rela.dyn.*)
    HIDDEN(__rela_dyn_end = .);
  }

  HIDDEN(__image_end = .);

  ASSERT((__image_end - __image_start) <= UKERNEL_KIMAGE_SLOT_SIZE,
    "uKernel image does not fit in UKERNEL_KIMAGE_SLOT_SIZE")

  .symtab         0 : { *(.symtab) }
  .strtab         0 : { *(.strtab) }
  .shstrtab       0 : { *(.shstrtab) }
  .debug_addr     0 : { *(.debug_addr) }
  .debug_aranges  0 : { *(.debug_aranges) }
  .debug_info     0 : { *(.debug_info .gnu.linkonce.wi.*) }
  .debug_abbrev   0 : { *(.debug_abbrev) }
  .debug_line     0 : { *(.debug_line .debug_line.* .debug_line_str) }
  .debug_str      0 : { *(.debug_str .debug_str.* .debug_str_offsets) }
  .debug_ranges   0 : { *(.debug_ranges) }
  .debug_rnglists 0 : { *(.debug_rnglists .debug_rnglists.*) }
  .debug_loc      0 : { *(.debug_loc .debug_loclists .debug_loclists.*) }
  .debug_frame    0 : { *(.debug_frame) }
  .gnu_debuglink  0 : { *(.gnu_debuglink) }
  .gnu_debugdata  0 : { *(.gnu_debugdata) }

  /DISCARD/ : {
    *(.comment)
    *(.note*)
    *(.dynamic)
    *(.dynsym) *(.dynstr)
    *(.hash) *(.gnu.hash)
  }
}
